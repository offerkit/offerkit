{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "offerkit",
  "compatibility_date": "2026-08-04",
  "workers_dev": false,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "offerkit.dev",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
