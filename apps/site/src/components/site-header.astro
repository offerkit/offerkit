---
import { GithubLogoIcon, StarIcon } from "@phosphor-icons/react/ssr";
import { formatGitHubStars, getGitHubStars } from "@/lib/github";

interface Props {
  active?: "blog" | "docs" | "home";
}

const { active = "home" } = Astro.props;
const githubStars = await getGitHubStars();
const githubStarsLabel = formatGitHubStars(githubStars);
const navItems = [
  { label: "Docs", href: "/docs/", id: "docs" },
  { label: "Blog", href: "/blog/", id: "blog" },
];
---

<header class="relative z-20 border-b border-[var(--site-border)] bg-white/85 backdrop-blur-xl">
  <div class="site-container flex h-16 items-center justify-between gap-2 sm:gap-6">
    <a href="/" class="group flex items-center gap-2.5" aria-label="OfferKit home">
      <img
        src="/icon.webp"
        alt=""
        width="34"
        height="34"
        class="size-8 rounded-[0.65rem] shadow-[0_4px_12px_rgba(65,84,109,0.12)] transition duration-200 group-hover:-translate-y-0.5"
      />
      <span class="hidden text-[1.02rem] font-bold tracking-[-0.035em] text-[var(--site-heading)] min-[25rem]:inline">OfferKit</span>
    </a>

    <nav class="flex items-center gap-1 text-sm" aria-label="Primary navigation">
      {navItems.map((item) => (
        <a
          href={item.href}
          aria-current={active === item.id ? "page" : undefined}
          class:list={[
            "rounded-lg px-3 py-2 transition hover:bg-[var(--site-bg-subtle)] hover:text-[var(--site-heading)]",
            active === item.id
              ? "bg-[var(--site-bg-subtle)] text-[var(--site-heading)]"
              : "text-[var(--site-muted)]",
          ]}
        >
          {item.label}
        </a>
      ))}
      <a
        href="https://github.com/offerkit/offerkit"
        target="_blank"
        rel="noreferrer"
        class="github-icon-link ml-1"
        aria-label={`OfferKit on GitHub${githubStars === null ? "" : `, ${githubStars.toLocaleString("en")} stars`}`}
      >
        <GithubLogoIcon size={20} weight="bold" aria-hidden="true" />
        <span class="github-star-count hidden md:inline-flex" aria-hidden="true">
          <StarIcon size={13} weight="fill" />
          {githubStarsLabel}
        </span>
      </a>
    </nav>
  </div>
</header>
