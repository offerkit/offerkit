---
interface Props {
  active?: "blog" | "docs" | "home";
}

const { active = "home" } = Astro.props;
const navItems = [
  { label: "Docs", href: "/docs", id: "docs" },
  { label: "Blog", href: "/blog", id: "blog" },
];
---

<header class="relative z-20 border-b border-[var(--site-border)] bg-[var(--site-bg)]">
  <div class="site-container flex h-16 items-center justify-between gap-2 sm:gap-6">
    <a href="/" class="group flex items-center gap-2.5" aria-label="OfferKit home">
      <img
        src="/icon.png"
        alt=""
        width="34"
        height="34"
        class="size-8 rounded-[0.35rem]"
      />
      <span class="hidden text-[1.02rem] font-bold tracking-[-0.035em] text-[var(--site-heading)] min-[25rem]:inline">OfferKit</span>
    </a>

    <nav class="flex items-center gap-1 text-sm" aria-label="Primary navigation">
      {navItems.map((item) => (
        <a
          href={item.href}
          aria-current={active === item.id ? "page" : undefined}
          class:list={[
            "rounded-[0.35rem] px-3 py-2 transition hover:bg-white hover:text-[var(--site-heading)]",
            active === item.id
              ? "bg-[var(--site-bg-subtle)] text-[var(--site-heading)]"
              : "text-[var(--site-muted)]",
          ]}
        >
          {item.label}
        </a>
      ))}
      <a
        href="https://github.com/offerkit/offerkit"
        target="_blank"
        rel="noreferrer"
        class="hidden rounded-[0.35rem] px-3 py-2 text-[var(--site-muted)] transition hover:bg-white hover:text-[var(--site-heading)] sm:block"
      >
        GitHub
      </a>
      <a
        href="/docs/getting-started"
        class="ml-1 rounded-[0.35rem] border border-[var(--site-heading)] bg-[var(--site-heading)] px-3 py-2 font-semibold text-white transition hover:border-[var(--site-primary-strong)] hover:bg-[var(--site-primary-strong)]"
      >
        <span class="sm:hidden">Start</span><span class="hidden sm:inline">Get started</span>
      </a>
    </nav>
  </div>
</header>
