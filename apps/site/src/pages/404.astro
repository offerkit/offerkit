---
import Layout from "@/components/layout.astro";
import SiteFooter from "@/components/site-footer.astro";
import SiteHeader from "@/components/site-header.astro";
import "@/styles/global.css";
---

<Layout title="Page not found" description="The requested OfferKit page does not exist." noIndex>
  <SiteHeader />
  <main class="site-container flex min-h-[70vh] max-w-2xl flex-col items-start justify-center py-20">
    <p class="site-kicker">404</p>
    <h1 class="mt-6 text-5xl font-bold tracking-[-0.055em] text-[var(--site-heading)]">Page not found.</h1>
    <p class="mt-5 max-w-lg text-lg leading-8 text-[var(--site-muted)]">
      The page may have moved, or the URL might be incomplete.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/" class="site-button-primary">Back home</a>
      <a href="/docs/" class="site-button-secondary">Browse docs</a>
    </div>
  </main>
  <SiteFooter />
</Layout>
