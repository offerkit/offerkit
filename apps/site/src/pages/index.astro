---
import Layout from "@/components/layout.astro";
import SiteFooter from "@/components/site-footer.astro";
import SiteHeader from "@/components/site-header.astro";
import "@/styles/global.css";

const capabilities = [
  {
    index: "01",
    title: "Discounts",
    description: "Fixed and percentage offers with targeting, usage limits, priority, exclusivity, and atomic stacking.",
    detail: "Codes, automatic offers, and cart rules",
    href: "/docs/solutions/public-promo-code",
  },
  {
    index: "02",
    title: "Gift cards",
    description: "Stored value with partial spend, expiration, rollback safety, and an immutable transaction ledger.",
    detail: "Balances that reconcile cleanly",
    href: "/docs/solutions/gift-cards",
  },
  {
    index: "03",
    title: "Loyalty",
    description: "Programs, tiers, earning rules, member balances, reward redemption, and points expiration.",
    detail: "Every point movement explained",
    href: "/docs/solutions/loyalty",
  },
  {
    index: "04",
    title: "Referrals",
    description: "Stable referral codes, idempotent conversion, and configurable rewards for both participants.",
    detail: "Issue, attribute, convert, reward",
    href: "/docs/solutions/referrals",
  },
];

const surfaces = [
  ["REST API", "OpenAPI 3.1", "/docs/reference/api-reference"],
  ["TypeScript SDK", "No codegen step", "/docs/reference/developer-tools"],
  ["CLI", "Back-office operations", "/docs/reference/developer-tools"],
  ["MCP server", "Tools with risk metadata", "/docs/reference/developer-tools"],
];

const steps = [
  ["Validate", "Preview the exact outcome while the cart changes. No counters or balances move."],
  ["Redeem", "Commit against a stable order ID. Retries return the original result."],
  ["Explain", "Receive typed, support-safe reasons when a rule rejects the request."],
  ["Observe", "Follow the decision through audit entries, events, signed webhooks, and telemetry."],
];

const validationExample = `const decision = await offerkit.vouchers.validate({
  params: { code: "WELCOME10" },
  body: {
    order: { amount: 9999, currency: "USD", items: [] },
  },
});`;
---

<Layout title="OfferKit">
  <div class="landing-shell">
    <SiteHeader active="home" />

    <main>
      <section class="landing-hero site-container">
        <div class="hero-copy">
          <p class="landing-label">Open-source promotion infrastructure</p>
          <h1>
            Promotions are infrastructure.
            <span>Run them like it.</span>
          </h1>
          <p class="hero-summary">
            One typed API for vouchers, gift cards, loyalty, and referrals. Keep the
            decision layer close to checkout, keep the data on your infrastructure, and
            keep every outcome explainable.
          </p>
          <div class="hero-actions">
            <a href="/docs/getting-started" class="landing-button-primary">Run OfferKit</a>
            <a href="https://github.com/offerkit/offerkit" class="landing-text-link">
              Read the source <span aria-hidden="true">↗</span>
            </a>
          </div>
          <dl class="hero-facts" aria-label="Project attributes">
            <div>
              <dt>License</dt>
              <dd>MIT</dd>
            </div>
            <div>
              <dt>Deploy</dt>
              <dd>One image</dd>
            </div>
            <div>
              <dt>Control</dt>
              <dd>Self-hosted</dd>
            </div>
          </dl>
        </div>

        <figure class="decision-example" aria-labelledby="decision-example-title">
          <figcaption class="decision-example-heading">
            <span id="decision-example-title">Voucher validation</span>
            <span>checkout.ts</span>
          </figcaption>
          <pre><code>{validationExample}</code></pre>
          <div class="decision-output">
            <p>Decision</p>
            <dl>
              <div>
                <dt>valid</dt>
                <dd>true</dd>
              </div>
              <div>
                <dt>discount</dt>
                <dd>USD 10.00</dd>
              </div>
              <div>
                <dt>order total</dt>
                <dd>USD 89.99</dd>
              </div>
            </dl>
          </div>
          <p class="decision-footnote">Read-only preview · zero state changes</p>
        </figure>
      </section>

      <section class="surface-index" aria-labelledby="surface-index-title">
        <div class="site-container">
          <h2 id="surface-index-title" class="sr-only">Developer surfaces</h2>
          <ul>
            {surfaces.map(([title, description, href], index) => (
              <li>
                <a href={href}>
                  <span class="surface-number">0{index + 1}</span>
                  <span class="surface-title">{title}</span>
                  <span class="surface-description">{description}</span>
                  <span class="surface-arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section class="capability-section site-container">
        <header class="section-intro">
          <p class="section-index">01 / Incentives</p>
          <div>
            <h2>One decision layer.<br />Four incentive types.</h2>
            <p>
              Stop rebuilding promotion rules inside checkout handlers and admin tools.
              OfferKit gives each incentive the same operational foundation.
            </p>
          </div>
        </header>

        <div class="capability-list">
          {capabilities.map((capability) => (
            <a class="capability-row" href={capability.href}>
              <span class="capability-index">{capability.index}</span>
              <div>
                <h3>{capability.title}</h3>
                <p class="capability-detail">{capability.detail}</p>
              </div>
              <p class="capability-description">{capability.description}</p>
              <span class="capability-arrow" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </section>

      <section class="contract-section">
        <div class="site-container contract-layout">
          <header class="contract-intro">
            <p class="section-index">02 / Checkout contract</p>
            <h2>Preview freely.<br />Commit once.</h2>
            <p>
              Promotion logic sits on a failure-sensitive path. OfferKit makes retries,
              concurrency, and rejection reasons part of the contract instead of leaving
              them to application code.
            </p>
            <a href="/docs/integrate/checkout" class="contract-link">
              Follow the checkout integration <span aria-hidden="true">→</span>
            </a>
          </header>

          <ol class="contract-steps">
            {steps.map(([title, description], index) => (
              <li>
                <span>0{index + 1}</span>
                <div>
                  <h3>{title}</h3>
                  <p>{description}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section class="install-section site-container">
        <div class="install-copy">
          <p class="section-index">03 / Deploy</p>
          <h2>Your promotion data stays yours.</h2>
          <p>
            Start with Docker Compose. Move the same published image to any container
            platform when you are ready.
          </p>
          <div class="install-actions">
            <a href="/docs/getting-started" class="landing-button-primary">Get started</a>
            <a href="/docs/self-host" class="landing-text-link">Self-hosting guide →</a>
          </div>
        </div>

        <div class="install-command" aria-label="OfferKit installation command">
          <p>Terminal</p>
          <code><span aria-hidden="true">$</span> docker compose up --build</code>
          <span class="install-note">API · dashboard · worker</span>
        </div>
      </section>
    </main>

    <SiteFooter />
  </div>
</Layout>

<style>
  .landing-shell {
    --landing-ink: #101828;
    --landing-green: #08775d;
    --landing-green-bright: #19a780;
    --landing-line: #d6dee8;
    min-height: 100vh;
    background: #f8fafc;
  }

  .landing-hero {
    display: grid;
    gap: 4rem;
    align-items: center;
    padding-block: 5.5rem 6rem;
  }

  .hero-copy {
    max-width: 42rem;
  }

  .landing-label,
  .section-index {
    color: var(--landing-green);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .landing-hero h1 {
    margin-top: 1.5rem;
    color: var(--landing-ink);
    font-size: clamp(3.65rem, 7.2vw, 6.8rem);
    font-weight: 760;
    letter-spacing: -0.075em;
    line-height: 0.91;
  }

  .landing-hero h1 span {
    display: block;
    color: var(--landing-green);
  }

  .hero-summary {
    max-width: 39rem;
    margin-top: 2rem;
    color: #58677c;
    font-size: 1.1rem;
    line-height: 1.75;
  }

  .hero-actions,
  .install-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
    margin-top: 2.25rem;
  }

  .landing-button-primary {
    display: inline-flex;
    min-height: 2.9rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--landing-ink);
    border-radius: 0.35rem;
    background: var(--landing-ink);
    padding: 0.75rem 1.15rem;
    color: white;
    font-size: 0.875rem;
    font-weight: 700;
    transition: background 140ms ease, border-color 140ms ease;
  }

  .landing-button-primary:hover {
    border-color: var(--landing-green);
    background: var(--landing-green);
  }

  .landing-text-link {
    color: var(--landing-ink);
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: #aab7c7;
    text-underline-offset: 0.3rem;
    transition: color 140ms ease, text-decoration-color 140ms ease;
  }

  .landing-text-link:hover {
    color: var(--landing-green);
    text-decoration-color: var(--landing-green);
  }

  .hero-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 1.75rem;
    margin-top: 2.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--landing-line);
  }

  .hero-facts div {
    display: grid;
    grid-template-columns: auto auto;
    gap: 0.45rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.7rem;
  }

  .hero-facts dt {
    color: #8a97a9;
    text-transform: uppercase;
  }

  .hero-facts dd {
    color: #35445a;
    font-weight: 700;
  }

  .decision-example {
    overflow: hidden;
    border: 1px solid #172033;
    border-radius: 0.4rem;
    background: #111827;
    box-shadow: 10px 10px 0 #d9eee8;
    color: #d7e0ed;
  }

  .decision-example-heading {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid #2a3549;
    padding: 0.9rem 1.1rem;
    color: #aebbd0;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .decision-example-heading span:first-child {
    color: #72d2b8;
    font-weight: 700;
  }

  .decision-example pre {
    overflow-x: auto;
    padding: 1.5rem 1.25rem 1.75rem;
    color: #e5eaf2;
    font-size: clamp(0.7rem, 1.15vw, 0.78rem);
    line-height: 1.9;
  }

  .decision-output {
    margin-inline: 1.1rem;
    border: 1px solid #344158;
    background: #172033;
  }

  .decision-output > p {
    border-bottom: 1px solid #344158;
    padding: 0.65rem 0.85rem;
    color: #8391a7;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .decision-output dl {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }

  .decision-output dl div {
    padding: 0.9rem 0.85rem;
    border-right: 1px solid #344158;
  }

  .decision-output dl div:last-child {
    border-right: 0;
  }

  .decision-output dt,
  .decision-output dd,
  .decision-footnote {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  }

  .decision-output dt {
    color: #8391a7;
    font-size: 0.62rem;
    text-transform: uppercase;
  }

  .decision-output dd {
    margin-top: 0.3rem;
    color: #f6f8fb;
    font-size: 0.76rem;
    font-weight: 700;
  }

  .decision-output dl div:first-child dd {
    color: #72d2b8;
  }

  .decision-footnote {
    padding: 1rem 1.1rem 1.2rem;
    color: #7f8da3;
    font-size: 0.63rem;
    text-transform: uppercase;
  }

  .surface-index {
    border-block: 1px solid var(--landing-line);
    background: #fff;
  }

  .surface-index ul {
    display: grid;
  }

  .surface-index li {
    border-bottom: 1px solid var(--landing-line);
  }

  .surface-index li:last-child {
    border-bottom: 0;
  }

  .surface-index a {
    display: grid;
    grid-template-columns: 2rem minmax(7.5rem, 0.75fr) 1fr auto;
    gap: 1rem;
    align-items: center;
    padding-block: 1rem;
    transition: color 140ms ease;
  }

  .surface-number,
  .surface-description {
    color: #8794a6;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.68rem;
  }

  .surface-title {
    color: var(--landing-ink);
    font-size: 0.86rem;
    font-weight: 750;
  }

  .surface-description {
    text-transform: uppercase;
  }

  .surface-arrow {
    color: #8794a6;
    transition: transform 140ms ease, color 140ms ease;
  }

  .surface-index a:hover .surface-title,
  .surface-index a:hover .surface-arrow {
    color: var(--landing-green);
  }

  .surface-index a:hover .surface-arrow {
    transform: translateX(0.2rem);
  }

  .capability-section {
    padding-block: 8rem;
  }

  .section-intro {
    display: grid;
    gap: 2rem;
    margin-bottom: 4.5rem;
  }

  .section-intro h2,
  .contract-intro h2,
  .install-copy h2 {
    color: var(--landing-ink);
    font-size: clamp(2.7rem, 5vw, 4.9rem);
    font-weight: 750;
    letter-spacing: -0.065em;
    line-height: 0.98;
  }

  .section-intro p:last-child,
  .contract-intro > p:nth-of-type(2),
  .install-copy > p:last-of-type {
    max-width: 36rem;
    margin-top: 1.5rem;
    color: #627086;
    font-size: 1.05rem;
    line-height: 1.75;
  }

  .capability-list {
    border-top: 1px solid #aeb9c7;
  }

  .capability-row {
    display: grid;
    grid-template-columns: 3rem minmax(10rem, 0.65fr) minmax(18rem, 1fr) auto;
    gap: 2rem;
    align-items: start;
    border-bottom: 1px solid var(--landing-line);
    padding-block: 2rem;
  }

  .capability-index,
  .capability-detail {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  }

  .capability-index {
    color: #8b97a8;
    font-size: 0.72rem;
  }

  .capability-row h3 {
    color: var(--landing-ink);
    font-size: 1.45rem;
    font-weight: 750;
    letter-spacing: -0.035em;
    transition: color 140ms ease;
  }

  .capability-detail {
    margin-top: 0.45rem;
    color: #8390a2;
    font-size: 0.67rem;
    text-transform: uppercase;
  }

  .capability-description {
    max-width: 38rem;
    color: #58677c;
    line-height: 1.7;
  }

  .capability-arrow {
    color: #8390a2;
    transition: color 140ms ease, transform 140ms ease;
  }

  .capability-row:hover h3,
  .capability-row:hover .capability-arrow {
    color: var(--landing-green);
  }

  .capability-row:hover .capability-arrow {
    transform: translate(0.15rem, -0.15rem);
  }

  .contract-section {
    background: #111827;
    color: #d8e0eb;
  }

  .contract-layout {
    display: grid;
    gap: 5rem;
    padding-block: 8rem;
  }

  .contract-intro .section-index {
    color: #72d2b8;
  }

  .contract-intro h2 {
    margin-top: 1.5rem;
    color: #f8fafc;
  }

  .contract-intro > p:nth-of-type(2) {
    color: #a9b5c7;
  }

  .contract-link {
    display: inline-flex;
    gap: 0.6rem;
    margin-top: 2rem;
    color: #91dfca;
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: #46685f;
    text-underline-offset: 0.3rem;
  }

  .contract-steps {
    border-top: 1px solid #3a465a;
  }

  .contract-steps li {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 1.5rem;
    border-bottom: 1px solid #3a465a;
    padding-block: 1.8rem;
  }

  .contract-steps li > span {
    color: #738198;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.7rem;
  }

  .contract-steps h3 {
    color: #f8fafc;
    font-size: 1.2rem;
    font-weight: 750;
  }

  .contract-steps p {
    max-width: 35rem;
    margin-top: 0.55rem;
    color: #a9b5c7;
    line-height: 1.7;
  }

  .install-section {
    display: grid;
    gap: 4.5rem;
    align-items: center;
    padding-block: 8rem;
  }

  .install-copy h2 {
    max-width: 39rem;
    margin-top: 1.5rem;
  }

  .install-command {
    border: 1px solid #bac4d1;
    border-radius: 0.35rem;
    background: #fff;
  }

  .install-command > p {
    border-bottom: 1px solid var(--landing-line);
    padding: 0.7rem 1rem;
    color: #7a8799;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .install-command code {
    display: block;
    overflow-x: auto;
    padding: 1.5rem 1rem 0.75rem;
    color: var(--landing-ink);
    font-size: clamp(0.78rem, 1.6vw, 0.95rem);
    white-space: nowrap;
  }

  .install-command code span {
    margin-right: 0.65rem;
    color: var(--landing-green);
    font-weight: 800;
  }

  .install-note {
    display: block;
    padding: 0.5rem 1rem 1.35rem;
    color: #8a97a9;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.65rem;
    text-transform: uppercase;
  }

  @media (min-width: 48rem) {
    .surface-index ul {
      grid-template-columns: repeat(2, 1fr);
    }

    .surface-index li:nth-child(odd) {
      border-right: 1px solid var(--landing-line);
    }

    .surface-index li:nth-last-child(-n + 2) {
      border-bottom: 0;
    }

    .surface-index a {
      padding-inline: 1.25rem;
    }

    .surface-index li:nth-child(odd) a {
      padding-left: 0;
    }

    .section-intro {
      grid-template-columns: minmax(10rem, 0.34fr) 1fr;
    }
  }

  @media (min-width: 64rem) {
    .landing-hero {
      grid-template-columns: minmax(0, 1.08fr) minmax(27rem, 0.92fr);
    }

    .surface-index ul {
      grid-template-columns: repeat(4, 1fr);
    }

    .surface-index li,
    .surface-index li:nth-child(odd) {
      border-right: 1px solid var(--landing-line);
      border-bottom: 0;
    }

    .surface-index li:last-child {
      border-right: 0;
    }

    .surface-index a {
      grid-template-columns: 1.6rem 1fr auto;
      gap: 0.7rem;
      padding-inline: 1.25rem;
    }

    .surface-index li:first-child a {
      padding-left: 0;
    }

    .surface-description {
      grid-column: 2 / -1;
    }

    .surface-arrow {
      grid-column: 3;
      grid-row: 1;
    }

    .contract-layout {
      grid-template-columns: minmax(0, 0.9fr) minmax(28rem, 1.1fr);
      gap: 7rem;
    }

    .install-section {
      grid-template-columns: minmax(0, 1fr) minmax(26rem, 0.72fr);
      gap: 7rem;
    }
  }

  @media (max-width: 47.99rem) {
    .landing-hero {
      gap: 3.25rem;
      padding-block: 4rem 4.5rem;
    }

		.landing-hero h1 {
			font-size: clamp(3rem, 13.4vw, 3.5rem);
		}

    .decision-example {
      box-shadow: 6px 6px 0 #d9eee8;
    }

    .decision-output dl {
      grid-template-columns: 1fr;
    }

    .decision-output dl div {
      border-right: 0;
      border-bottom: 1px solid #344158;
    }

    .decision-output dl div:last-child {
      border-bottom: 0;
    }

    .surface-index a {
      grid-template-columns: 2rem 1fr auto;
    }

    .surface-description {
      grid-column: 2;
    }

    .surface-arrow {
      grid-column: 3;
      grid-row: 1 / span 2;
    }

    .capability-section,
    .contract-layout,
    .install-section {
      padding-block: 5.5rem;
    }

    .section-intro {
      margin-bottom: 3rem;
    }

    .capability-row {
      grid-template-columns: 2rem 1fr auto;
      gap: 1rem;
      padding-block: 1.6rem;
    }

    .capability-description {
      grid-column: 2 / -1;
    }

    .capability-arrow {
      grid-column: 3;
      grid-row: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .landing-button-primary,
    .landing-text-link,
    .surface-arrow,
    .capability-row h3,
    .capability-arrow {
      transition: none;
    }
  }
</style>
