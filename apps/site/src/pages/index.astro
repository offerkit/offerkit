---
import {
  GiftIcon,
  GithubLogoIcon,
  MedalIcon,
  StarIcon,
  TagIcon,
  UsersThreeIcon,
} from "@phosphor-icons/react/ssr";
import Layout from "@/components/layout.astro";
import SiteFooter from "@/components/site-footer.astro";
import SiteHeader from "@/components/site-header.astro";
import { formatGitHubStars, getGitHubStars } from "@/lib/github";
import "@/styles/global.css";

const githubStars = await getGitHubStars();
const githubStarsLabel = formatGitHubStars(githubStars);

const capabilities = [
  {
    id: "discounts",
    title: "Discounts",
    description: "Fixed or percentage offers, eligibility rules, limits, stacking, and atomic redemption.",
    Icon: TagIcon,
    className: "bento-discounts",
  },
  {
    id: "gift-cards",
    title: "Gift cards",
    description: "Stored balances with partial spend, an immutable ledger, expiration, and rollback safety.",
    Icon: GiftIcon,
    className: "bento-gift-cards",
  },
  {
    id: "loyalty",
    title: "Loyalty",
    description: "Programs, tiers, earning rules, rewards, member ledgers, and points expiration.",
    Icon: MedalIcon,
    className: "bento-loyalty",
  },
  {
    id: "referrals",
    title: "Referrals",
    description: "Stable referral codes, idempotent conversion, and configurable rewards for both sides.",
    Icon: UsersThreeIcon,
    className: "bento-referrals",
  },
];

const surfaces = [
  ["REST API", "OpenAPI 3.1 from the live contract"],
  ["TypeScript SDK", "Types without a codegen step"],
  ["CLI", "Back-office actions from the terminal"],
  ["MCP server", "Agent tools with explicit risk metadata"],
];

const steps = [
  {
    id: "validate",
    title: "Validate",
    description: "Preview eligibility without changing counters or balances.",
    method: "POST",
    endpoint: "/api/v1/vouchers/SUMMER10/validate",
    code: `const preview = await offerkit.vouchers.validate({
  code: "SUMMER10",
  order: { amount: 9999, currency: "USD" },
});`,
    event: "voucher.eligible",
    status: "200 OK",
    details: ["Rules evaluated", "No state changed", "Reason included"],
  },
  {
    id: "redeem",
    title: "Redeem",
    description: "Commit atomically with a stable idempotency key.",
    method: "POST",
    endpoint: "/api/v1/vouchers/SUMMER10/redemption",
    code: `const result = await offerkit.vouchers.redeem({
  code: "SUMMER10",
  order: { amount: 9999, currency: "USD" },
  idempotencyKey: "order-42",
});`,
    event: "redemption.accepted",
    status: "200 OK",
    details: ["Idempotent", "Balance committed", "Event emitted"],
  },
  {
    id: "explain",
    title: "Explain",
    description: "Return typed, support-safe reasons for every rejection.",
    method: "POST",
    endpoint: "/api/v1/vouchers/WELCOME/explain",
    code: `const decision = await offerkit.vouchers.explain({
  code: "WELCOME",
  customerId: "cus_88",
  order: { amount: 2400, currency: "USD" },
});`,
    event: "voucher.ineligible",
    status: "MINIMUM_NOT_MET",
    details: ["Typed reason", "Safe for support", "Rule identified"],
  },
  {
    id: "observe",
    title: "Observe",
    description: "Trace events, signed webhooks, audit entries, and telemetry.",
    method: "GET",
    endpoint: "/api/v1/events?subject=order-42",
    code: `const events = await offerkit.events.list({
  subject: "order-42",
  types: ["redemption.accepted"],
});`,
    event: "webhook.delivered",
    status: "SIGNED",
    details: ["Audit linked", "Webhook verified", "Trace available"],
  },
];
---

<Layout title="OfferKit">
  <div class="relative overflow-hidden">
    <div class="site-grid pointer-events-none absolute inset-x-0 top-0 h-[52rem]"></div>
    <SiteHeader active="home" />

    <main>
      <section class="site-container relative grid gap-14 py-16 sm:py-24 lg:grid-cols-[0.88fr_1.12fr] lg:items-center lg:gap-16 lg:py-28">
        <div class="relative z-10">
          <h1 class="max-w-3xl text-5xl font-bold leading-[0.98] tracking-[-0.065em] text-[var(--site-heading)] sm:text-6xl lg:text-[4.65rem]">
            Promotions are infrastructure.
            <span class="block text-[var(--site-primary)]">Treat them like it.</span>
          </h1>
          <p class="mt-7 max-w-2xl text-lg leading-8 text-[var(--site-muted)] sm:text-xl">
            Run vouchers, gift cards, loyalty, and referrals behind one typed API. OfferKit is
            MIT-licensed, agent-ready, and yours to deploy.
          </p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href="/docs/getting-started/" class="site-button-primary">
              Get started <span class="ml-2" aria-hidden="true">→</span>
            </a>
            <a
              href="https://github.com/offerkit/offerkit"
              target="_blank"
              rel="noreferrer"
              class="site-button-secondary"
              aria-label={`Check out OfferKit on GitHub${githubStars === null ? "" : `, ${githubStars.toLocaleString("en")} stars`}`}
            >
              <GithubLogoIcon size={19} weight="bold" aria-hidden="true" />
              <span class="ml-2">Checkout on GitHub</span>
              <span class="cta-star-count cta-star-count-secondary" aria-hidden="true">
                <StarIcon size={13} weight="fill" />
                {githubStarsLabel}
              </span>
            </a>
          </div>
        </div>

        <div class="hero-system" data-hero-system aria-label="Live OfferKit promotion flow">
          <div class="hero-system-header">
            <div>
              <span class="hero-system-eyebrow">Promotion graph</span>
              <strong>Live checkout</strong>
            </div>
            <span class="hero-system-status"><span></span> Operational</span>
          </div>

          <div class="hero-canvas">
            <svg class="hero-flow-lines" viewBox="0 0 720 420" role="img" aria-label="Checkout request flowing through OfferKit to promotion outcomes">
              <path d="M165 210 C235 210 244 210 310 210"></path>
              <path d="M408 210 C470 210 470 72 540 72"></path>
              <path d="M408 210 C482 210 474 166 540 166"></path>
              <path d="M408 210 C482 210 474 260 540 260"></path>
              <path d="M408 210 C470 210 470 354 540 354"></path>
              <circle r="4" fill="var(--site-teal)">
                <animateMotion dur="2.2s" repeatCount="indefinite" path="M165 210 C235 210 244 210 310 210"></animateMotion>
              </circle>
            </svg>

            <div class="hero-request">
              <span>Incoming checkout</span>
              <strong data-hero-code>SUMMER10</strong>
              <small data-hero-order>$129.00 order</small>
            </div>

            <div class="hero-engine">
              <span class="hero-engine-mark">OK</span>
              <strong>OfferKit</strong>
              <small>evaluate()</small>
            </div>

            <div class="hero-outcome hero-outcome-discounts is-active" data-hero-outcome="discounts">
              <TagIcon size={18} weight="bold" aria-hidden="true" />
              <span><strong>Discount</strong><small data-hero-result>− $12.90</small></span>
            </div>
            <div class="hero-outcome hero-outcome-gift" data-hero-outcome="gift-cards">
              <GiftIcon size={18} weight="bold" aria-hidden="true" />
              <span><strong>Gift card</strong><small>Balance checked</small></span>
            </div>
            <div class="hero-outcome hero-outcome-loyalty" data-hero-outcome="loyalty">
              <MedalIcon size={18} weight="bold" aria-hidden="true" />
              <span><strong>Loyalty</strong><small>+116 points</small></span>
            </div>
            <div class="hero-outcome hero-outcome-referrals" data-hero-outcome="referrals">
              <UsersThreeIcon size={18} weight="bold" aria-hidden="true" />
              <span><strong>Referral</strong><small>Reward queued</small></span>
            </div>
          </div>

          <div class="hero-activity">
            <span class="hero-activity-check">✓</span>
            <span><strong data-hero-event>redemption.accepted</strong><small data-hero-meta>42 ms · order_1042</small></span>
            <span class="hero-activity-status">200 OK</span>
          </div>
        </div>
      </section>

      <section class="border-y border-[var(--site-border)] bg-white/65">
        <div class="site-container grid divide-y divide-[var(--site-border)] sm:grid-cols-2 sm:divide-x sm:divide-y-0 lg:grid-cols-4">
          {surfaces.map(([title, description]) => (
            <div class="px-6 py-7 first:pl-0 last:pr-0 sm:first:pl-6 lg:first:pl-0">
              <div class="flex items-center gap-2.5">
                <span class="grid size-5 place-items-center rounded-full bg-[var(--site-primary-soft)] text-xs font-bold text-[var(--site-primary-strong)]">✓</span>
                <p class="text-sm font-bold text-[var(--site-heading)]">{title}</p>
              </div>
              <p class="mt-2 text-sm leading-6 text-[var(--site-muted)]">{description}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="site-container py-24 sm:py-32">
        <div class="max-w-2xl">
          <h2 class="text-4xl font-bold tracking-[-0.05em] text-[var(--site-heading)] sm:text-5xl">
            One model for every incentive.
          </h2>
          <p class="mt-5 text-lg leading-8 text-[var(--site-muted)]">
            Replace scattered checkout conditionals and one-off admin tools with a system your
            team can inspect, test, and operate.
          </p>
        </div>

        <div class="capability-bento mt-12">
          {capabilities.map(({ id, title, description, Icon, className }) => (
            <article class:list={["capability-card site-card", className]}>
              <div class="capability-copy">
                <span class="capability-icon"><Icon size={25} weight="duotone" aria-hidden="true" /></span>
                <h3>{title}</h3>
                <p>{description}</p>
              </div>

              {id === "discounts" && (
                <div class="discount-visual" aria-hidden="true">
                  <div class="discount-total">
                    <span>Cart total</span>
                    <strong>$129.00</strong>
                  </div>
                  <div class="discount-rule"><span>SUMMER10</span><strong>−10%</strong></div>
                  <div class="discount-rule"><span>Loyal member</span><strong>−$5</strong></div>
                  <div class="discount-final"><span>Due now</span><strong>$111.10</strong></div>
                </div>
              )}

              {id === "gift-cards" && (
                <div class="gift-card-visual" aria-hidden="true">
                  <div class="gift-card-balance"><span>Available</span><strong>$84.50</strong></div>
                  <div class="gift-card-ledger"><span>Order #1042</span><strong>−$24.00</strong></div>
                  <div class="gift-card-line"><span style="width: 72%"></span></div>
                </div>
              )}

              {id === "loyalty" && (
                <div class="loyalty-visual" aria-hidden="true">
                  <div><span>Gold tier</span><strong>2,840 pts</strong></div>
                  <div class="loyalty-track"><span></span></div>
                  <small>160 points to next reward</small>
                </div>
              )}

              {id === "referrals" && (
                <div class="referral-visual" aria-hidden="true">
                  <span class="referral-person">AM</span>
                  <span class="referral-line"></span>
                  <span class="referral-person">JK</span>
                  <span class="referral-reward">Reward both sides</span>
                </div>
              )}
            </article>
          ))}
        </div>
      </section>

      <section class="border-y border-[var(--site-border)] bg-[var(--site-bg-subtle)] py-24 sm:py-32" data-hotpath>
        <div class="site-container grid gap-14 lg:grid-cols-[0.8fr_1.2fr] lg:items-start lg:gap-24">
          <div>
            <h2 class="text-4xl font-bold tracking-[-0.05em] text-[var(--site-heading)] sm:text-5xl">
              Own the hot path.
            </h2>
            <p class="mt-5 text-lg leading-8 text-[var(--site-muted)]">
              Checkout logic needs clear outcomes under retries, concurrency, and partial failure.
              OfferKit makes those constraints part of the contract.
            </p>
            <a class="mt-7 inline-flex text-sm font-semibold text-[var(--site-primary-strong)] transition hover:text-[var(--site-primary)]" href="/docs/api-reference/">
              Read the API conventions <span class="ml-2" aria-hidden="true">→</span>
            </a>
          </div>

          <div class="contract-window site-card">
            <div class="contract-toolbar">
              <span>Live contract</span>
              <span class="contract-ready"><span></span> Ready</span>
            </div>
            <div class="contract-stage">
              {steps.map((step, index) => (
                <article
                  class:list={["contract-panel", index === 0 && "is-active"]}
                  data-contract-panel={step.id}
                  id={`hotpath-panel-${step.id}`}
                  role="tabpanel"
                  aria-labelledby={`hotpath-tab-${step.id}`}
                  hidden={index !== 0}
                >
                  <div class="contract-endpoint">
                    <span>{step.method}</span>
                    <code>{step.endpoint}</code>
                  </div>
                  <pre><code>{step.code}</code></pre>
                  <div class="contract-response">
                    <div>
                      <span>{step.event}</span>
                      <strong>{step.status}</strong>
                    </div>
                    <ul>
                      {step.details.map((detail) => <li>{detail}</li>)}
                    </ul>
                  </div>
                </article>
              ))}
            </div>
          </div>
        </div>

        <div class="site-container mt-12 grid gap-3 sm:grid-cols-2 lg:grid-cols-4" role="tablist" aria-label="OfferKit contract stages">
          {steps.map((step, index) => (
            <button
              type="button"
              class:list={["hotpath-tab", index === 0 && "is-active"]}
              data-hotpath-tab={step.id}
              id={`hotpath-tab-${step.id}`}
              role="tab"
              aria-controls={`hotpath-panel-${step.id}`}
              aria-selected={index === 0 ? "true" : "false"}
              tabindex={index === 0 ? 0 : -1}
            >
              <span class="hotpath-tab-title">{step.title}</span>
              <span class="hotpath-tab-copy">{step.description}</span>
              <span class="hotpath-progress" aria-hidden="true"><span></span></span>
            </button>
          ))}
        </div>
      </section>

      <section class="site-container py-24 sm:py-32">
        <div class="cta-card site-card relative overflow-hidden px-6 py-16 text-center sm:px-12 sm:py-20">
          <div class="absolute -left-16 -top-16 size-44 rounded-full bg-[#2db99a]/10 blur-2xl"></div>
          <div class="absolute -bottom-20 -right-16 size-52 rounded-full bg-[#388df2]/10 blur-2xl"></div>
          <img src="/icon.webp" alt="" width="72" height="72" class="relative mx-auto size-[4.5rem] rounded-2xl shadow-[0_12px_28px_rgba(68,88,113,0.16)]" />
          <h2 class="relative mx-auto mt-8 max-w-3xl text-4xl font-bold tracking-[-0.055em] text-[var(--site-heading)] sm:text-5xl">
            Your promotions. Your data. Your infrastructure.
          </h2>
          <p class="relative mx-auto mt-5 max-w-2xl text-lg leading-8 text-[var(--site-muted)]">
            Start locally, keep the contract stable, and deploy OfferKit wherever your stack runs.
          </p>
          <div class="relative mt-8 flex flex-wrap justify-center gap-3">
            <a href="/docs/getting-started/" class="site-button-primary">Get started</a>
            <a href="/docs/self-host/" class="site-button-secondary">Self-hosting guide</a>
          </div>
        </div>
      </section>
    </main>

    <SiteFooter />
  </div>
</Layout>

<script>
  const HERO_ROTATION_MS = 2_600;
  const HOTPATH_ROTATION_MS = 3_000;

  function initializeHeroVisualization() {
    const root = document.querySelector<HTMLElement>("[data-hero-system]");
    if (!root || root.dataset.initialized === "true") return;
    root.dataset.initialized = "true";

    const scenarios = [
      { code: "SUMMER10", order: "$129.00 order", target: "discounts", result: "− $12.90", event: "redemption.accepted", meta: "42 ms · order_1042" },
      { code: "GIFT-84K", order: "$24.00 order", target: "gift-cards", result: "Balance checked", event: "gift_card.debited", meta: "38 ms · order_1043" },
      { code: "GOLD-MEMBER", order: "$86.40 order", target: "loyalty", result: "+116 points", event: "points.credited", meta: "45 ms · order_1044" },
      { code: "REFER-AK", order: "New customer", target: "referrals", result: "Reward queued", event: "referral.converted", meta: "40 ms · customer_882" },
    ];
    let scenarioIndex = 0;

    const renderScenario = () => {
      const scenario = scenarios[scenarioIndex];
      root.querySelector<HTMLElement>("[data-hero-code]")!.textContent = scenario.code;
      root.querySelector<HTMLElement>("[data-hero-order]")!.textContent = scenario.order;
      root.querySelector<HTMLElement>("[data-hero-event]")!.textContent = scenario.event;
      root.querySelector<HTMLElement>("[data-hero-meta]")!.textContent = scenario.meta;
      root.querySelectorAll<HTMLElement>("[data-hero-outcome]").forEach((outcome) => {
        const isActive = outcome.dataset.heroOutcome === scenario.target;
        outcome.classList.toggle("is-active", isActive);
        if (isActive) outcome.querySelector("small")!.textContent = scenario.result;
      });
    };

    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      const timer = window.setInterval(() => {
        if (!root.isConnected) return window.clearInterval(timer);
        scenarioIndex = (scenarioIndex + 1) % scenarios.length;
        renderScenario();
      }, HERO_ROTATION_MS);
    }
  }

  function initializeHotpathSlideshow() {
    const root = document.querySelector<HTMLElement>("[data-hotpath]");
    if (!root || root.dataset.initialized === "true") return;
    root.dataset.initialized = "true";

    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-hotpath-tab]"));
    const panels = Array.from(root.querySelectorAll<HTMLElement>("[data-contract-panel]"));
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let activeIndex = 0;
    let timer: number | undefined;

    const showStep = (nextIndex: number, restart = true) => {
      activeIndex = (nextIndex + tabs.length) % tabs.length;
      tabs.forEach((tab, index) => {
        const isActive = index === activeIndex;
        tab.classList.toggle("is-active", isActive);
        tab.setAttribute("aria-selected", String(isActive));
        tab.tabIndex = isActive ? 0 : -1;
      });
      panels.forEach((panel, index) => {
        const isActive = index === activeIndex;
        panel.classList.toggle("is-active", isActive);
        panel.hidden = !isActive;
      });

      if (restart && !reduceMotion) {
        if (timer) window.clearInterval(timer);
        timer = window.setInterval(() => {
          if (!root.isConnected) return timer && window.clearInterval(timer);
          showStep(activeIndex + 1, false);
        }, HOTPATH_ROTATION_MS);
      }
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => showStep(index));
      tab.addEventListener("keydown", (event) => {
        if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
        event.preventDefault();
        const direction = event.key === "ArrowRight" ? 1 : -1;
        showStep(activeIndex + direction);
        tabs[(activeIndex + tabs.length) % tabs.length].focus();
      });
    });

    showStep(0);
  }

  function initializeLandingPage() {
    initializeHeroVisualization();
    initializeHotpathSlideshow();
  }

  initializeLandingPage();
  document.addEventListener("astro:page-load", initializeLandingPage);
</script>

<style>
  .cta-star-count {
    display: inline-flex;
    align-items: center;
    gap: 0.26rem;
    margin-left: 0.65rem;
    border-left: 1px solid rgba(255, 255, 255, 0.28);
    padding-left: 0.65rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.68rem;
  }

  .cta-star-count-secondary {
    border-left-color: var(--site-border);
    color: var(--site-muted);
  }

  .hero-system {
    position: relative;
    min-height: 31rem;
    overflow: hidden;
    border: 1px solid var(--site-border);
    border-radius: 1.75rem;
    background:
      linear-gradient(rgba(216, 225, 234, 0.38) 1px, transparent 1px),
      linear-gradient(90deg, rgba(216, 225, 234, 0.38) 1px, transparent 1px),
      linear-gradient(150deg, #ffffff, #f5faf8);
    background-size: 28px 28px, 28px 28px, auto;
    box-shadow: var(--site-shadow-lg);
  }

  .hero-system::after {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.82);
    pointer-events: none;
    content: "";
  }

  .hero-system-header {
    position: relative;
    z-index: 3;
    display: flex;
    min-height: 4.6rem;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--site-border);
    background: rgba(255, 255, 255, 0.82);
    padding: 0.9rem 1.15rem;
    backdrop-filter: blur(12px);
  }

  .hero-system-header > div {
    display: grid;
    gap: 0.15rem;
  }

  .hero-system-header strong {
    color: var(--site-heading);
    font-size: 0.88rem;
  }

  .hero-system-eyebrow {
    color: var(--site-muted-light);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hero-system-status,
  .contract-ready {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--site-primary-strong);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .hero-system-status > span,
  .contract-ready > span {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 999px;
    background: var(--site-teal);
    box-shadow: 0 0 0 4px rgba(45, 185, 154, 0.12);
  }

  .hero-canvas {
    position: relative;
    min-height: 21rem;
  }

  .hero-flow-lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .hero-flow-lines path {
    fill: none;
    stroke: #c9d6df;
    stroke-dasharray: 5 6;
    stroke-width: 1.4;
  }

  .hero-request,
  .hero-engine,
  .hero-outcome {
    position: absolute;
    z-index: 2;
    border: 1px solid var(--site-border);
    background: rgba(255, 255, 255, 0.94);
    box-shadow: 0 9px 22px rgba(65, 84, 109, 0.1);
  }

  .hero-request {
    top: 40%;
    left: 3.5%;
    display: grid;
    width: 25%;
    min-width: 7.5rem;
    gap: 0.25rem;
    border-radius: 0.9rem;
    padding: 0.8rem;
    transform: translateY(-50%);
  }

  .hero-request span,
  .hero-request small,
  .hero-engine small,
  .hero-outcome small {
    color: var(--site-muted-light);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.58rem;
  }

  .hero-request strong {
    overflow: hidden;
    color: var(--site-heading);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.7rem;
    text-overflow: ellipsis;
  }

  .hero-engine {
    top: 40%;
    left: 42.5%;
    display: grid;
    width: 6.6rem;
    place-items: center;
    gap: 0.25rem;
