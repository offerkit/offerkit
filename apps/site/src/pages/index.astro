---
import {
  ArrowRightIcon,
  CheckIcon,
  CopyIcon,
  GiftIcon,
  GithubLogoIcon,
  MedalIcon,
  TagIcon,
  UsersThreeIcon,
} from "@phosphor-icons/react/ssr";
import Layout from "@/components/layout.astro";
import SiteFooter from "@/components/site-footer.astro";
import SiteHeader from "@/components/site-header.astro";
import { getLatestRelease } from "@/lib/github";
import "@/styles/global.css";

const latestRelease = await getLatestRelease();
const githubUrl = "https://github.com/offerkit/offerkit";

type Lang = "ts" | "json" | "bash";

const KEYWORDS = new Set([
  "const", "await", "import", "from", "export", "async", "function", "return", "if", "true", "false", "null",
]);

/** Minimal, dependency-free syntax highlighting for the static snippets on this page. */
function highlight(code: string, lang: Lang) {
  const escaped = code.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  const comment = lang === "bash" ? String.raw`#.*$` : String.raw`\/\/.*$`;
  const pattern = new RegExp(
    `(${comment})|("(?:[^"\\\\]|\\\\.)*"|'(?:[^'\\\\]|\\\\.)*')|\\b([A-Za-z_]+)\\b|(\\b\\d[\\d_]*\\b)`,
    "gm",
  );
  return escaped.replace(pattern, (match, isComment, isString, word, isNumber, offset: number, whole: string) => {
    if (isComment) return `<span class="tok-comment">${match}</span>`;
    if (isString) {
      const isKey = lang === "json" && /^\s*:/.test(whole.slice(offset + match.length));
      return `<span class="${isKey ? "tok-key" : "tok-string"}">${match}</span>`;
    }
    if (word) return lang !== "bash" && KEYWORDS.has(word) ? `<span class="tok-keyword">${match}</span>` : match;
    if (isNumber) return `<span class="tok-number">${match}</span>`;
    return match;
  });
}

const quickstart = `git clone https://github.com/offerkit/offerkit
cd offerkit && cp .env.example .env
docker compose up`;

const targetingRule = `{
  "and": [
    { ">=": [
      { "var": "order.amount" },
      4000
    ] },
    { "===": [
      { "var": "customer.metadata.vip" },
      true
    ] }
  ]
}`;

const finalCommands = `# In your checkout server
npm install @offerkit/sdk

# Or try the CLI against your instance
npm install -g @offerkit/cli
offerkit login --url http://localhost:3000 \\
  --api-key offerkit_…
offerkit vouchers validate WELCOME10 \\
  --amount 5000`;

const validateRequest = `// On your server, with an OfferKit API key
await offerkit.vouchers.validate({
  params: { code: "WELCOME10" },
  body: {
    order: { amount: 5000, currency: "USD" },
  },
});`;

const heroExamples = [
  {
    id: "valid",
    label: "Validate",
    short: "Valid",
    status: "valid",
    request: validateRequest,
    note: "WELCOME10 takes a fixed USD 10.00 off. 5000 means USD 50.00, because amounts are integers in minor units.",
    json: `{
  "valid": true,
  "preview": {
    "amount": 1000,
    "finalOrder": {
      "amount": 4000,
      "currency": "USD"
    }
  }
}`,
  },
  {
    id: "rejected",
    label: "Wrong currency",
    short: "EUR",
    status: "rejected",
    request: validateRequest.replace('"USD"', '"EUR"'),
    note: "Rejections return a typed code your checkout can branch on, plus a readable message.",
    json: `{
  "valid": false,
  "code": "currency_mismatch",
  "explanations": [
    {
      "code": "currency_mismatch",
      "voucherCode": "WELCOME10"
    }
  ]
}`,
  },
  {
    id: "stacked",
    label: "Stack two codes",
    short: "Stacked",
    status: "redeemed",
    request: `await offerkit.vouchers.stackRedeem({
  codes: ["SUMMER15", "LOYAL5"],
  order: { amount: 10000, currency: "USD" },
  idempotencyKey: "order_5002",
});`,
    note: "15% plus USD 5.00 off a USD 100.00 cart, committed in one transaction. If either code fails, neither is used.",
    json: `{
  "ok": true,
  "amount": 2000,
  "finalOrder": { "amount": 8000 },
  "breakdown": [
    { "code": "SUMMER15", "amount": 1500 },
    { "code": "LOYAL5", "amount": 500 }
  ]
}`,
  },
];

const facts = [
  { label: "License", value: "MIT. No enterprise edition.", href: `${githubUrl}/blob/main/LICENSE` },
  latestRelease
    ? {
        label: "Latest release",
        value: latestRelease.publishedAt
          ? `${latestRelease.tag} · ${latestRelease.publishedAt.toLocaleDateString("en", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" })}`
          : latestRelease.tag,
        href: latestRelease.url,
      }
    : { label: "Releases", value: "On GitHub", href: `${githubUrl}/releases` },
  { label: "Runs on", value: "Node.js, Postgres, Redis", href: undefined },
  { label: "Docker image", value: "ghcr.io/offerkit/offerkit", href: `${githubUrl}/pkgs/container/offerkit` },
];

const incentives = [
  {
    title: "Discounts",
    description: "Fixed or percentage codes with caps, product and collection eligibility, and limits. Generate up to 100,000 unique codes in one call.",
    call: "vouchers.validate WELCOME10, USD 50.00 cart",
    result: "USD 10.00 off · USD 40.00 due",
    Icon: TagIcon,
  },
  {
    title: "Gift cards",
    description: "Stored balances you can spend in part. Every debit lands in an append-only transaction ledger.",
    call: "vouchers.redeem on a USD 50.00 card, USD 18.50 order",
    result: "USD 18.50 spent · USD 31.50 left",
    Icon: GiftIcon,
  },
  {
    title: "Loyalty",
    description: "Programs with tiers, rewards, and a points ledger. Points can expire per earning.",
    call: "loyalty.members.earn, 129 base points for order_5003",
    result: "+129 points · balance 129 · EARN ledger entry",
    Icon: MedalIcon,
  },
  {
    title: "Referrals",
    description: "A stable code per advocate. Each conversion is recorded once and rewards both sides.",
    call: "referrals.convert ANNA-UfXSjyQq",
    result: "USD 10.00 voucher to each person",
    Icon: UsersThreeIcon,
  },
];

const guarantees = [
  {
    title: "Validation never writes",
    body: "Preview a code each time the cart changes. Counters, balances, and limits stay untouched.",
    token: "POST /api/v1/vouchers/{code}/validate",
  },
  {
    title: "Retries are idempotent",
    body: "Use the order ID as the idempotency key. A retry returns the first result instead of redeeming twice.",
    token: "idempotencyKey: order.id",
  },
  {
    title: "Stacking is all-or-nothing",
    body: "Apply up to 20 codes to one order in a single database transaction. All commit, or none do.",
    token: "POST /api/v1/redemptions/stack",
  },
  {
    title: "Every rejection has a reason",
    body: "Sixteen typed codes, from expired vouchers to spent limits, each with a message support can read.",
    token: `"code": "redemption_limit_reached"`,
  },
  {
    title: "Your application handles reversals",
    body: "There is no public rollback endpoint, and cancelling an order does not reverse a redemption. Issue a replacement voucher, adjust loyalty points, or refund through your commerce system.",
    token: "Recovery guide →",
  },
];

const retryRequest = `const body = {
  order: { amount: 5000, currency: "USD" },
  idempotencyKey: "order_5001",
};
const redeem = () =>
  offerkit.vouchers.redeem({
    params: { code: "WELCOME10" },
    body,
  });

try {
  await redeem();
} catch {
  // Only transport errors throw. Rejections
  // return { ok: false, code } instead.
  await redeem();
}`;

const retryResponse = `{
  "ok": true,
  "redemptionId": "b32060f3-46e9-…",
  "amount": 1000,
  "idempotent": true
}`;

const interfaces = [
  {
    id: "sdk",
    label: "TypeScript SDK",
    short: "SDK",
    caption: "Typed from the contract. Nothing to regenerate.",
    lang: "ts" as Lang,
    code: `import { createClient } from "@offerkit/sdk";

const offerkit = createClient({
  baseUrl: process.env.OFFERKIT_API_URL,
  apiKey: process.env.OFFERKIT_API_KEY,
});

// In your order handler
await offerkit.vouchers.redeem({
  params: { code: "WELCOME10" },
  body: {
    order: { amount: 5000, currency: "USD" },
    idempotencyKey: order.id,
  },
});`,
  },
  {
    id: "rest",
    label: "REST API",
    short: "REST",
    caption: "Plain HTTP with an OpenAPI 3.1 document.",
    lang: "bash" as Lang,
    code: `curl -X POST \\
  "$OFFERKIT_API_URL/api/v1/vouchers/WELCOME10/redemption" \\
  -H "Authorization: Bearer $OFFERKIT_API_KEY" \\
  -H "Content-Type: application/json" \\
  -d '{
    "order": { "amount": 5000, "currency": "USD" },
    "idempotencyKey": "order_5001"
  }'`,
  },
  {
    id: "cli",
    label: "CLI",
    short: "CLI",
    caption: "Back-office work from a terminal or script.",
    lang: "bash" as Lang,
    code: `npm install -g @offerkit/cli
offerkit login --url https://offers.example.com \\
  --api-key offerkit_…

offerkit vouchers validate WELCOME10 \\
  --amount 5000
offerkit vouchers redeem WELCOME10 \\
  --amount 5000 --idempotency-key order_5001`,
  },
  {
    id: "mcp",
    label: "MCP server",
    short: "MCP",
    caption: "OAuth-protected tools, each marked safe, mutating, or destructive.",
    lang: "bash" as Lang,
    code: `# On the OfferKit web service
OFFERKIT_MCP_ENABLED=true

# In Claude Code
claude mcp add --transport http offerkit \\
  https://offers.example.com/mcp

# In Codex
codex mcp add offerkit \\
  --url https://offers.example.com/mcp`,
  },
];

const voucherifyPricingUrl = "https://www.voucherify.io/pricing";

const comparison = [
  ["Price", "Free. You pay for your own hosting.", "From $650/month for 25,000 API calls (Business plan)"],
  ["License", "MIT. Read, fork, and patch the engine.", "Proprietary"],
  ["Hosting and data", "Your infrastructure and your Postgres", "Vendor cloud. Private hosting on Enterprise."],
  ["Operations", "You run Postgres, Redis, and upgrades", "Managed, with custom SLAs on Enterprise"],
  ["Interfaces", "REST, SDK, CLI, and a self-hosted MCP server, all from one contract", "REST API and SDKs"],
  ["Programs", "Coupons, gift cards, loyalty, referrals", "Those, plus bundling, gamification, and wallets"],
  ["Usage limits", "None. Throughput depends on your hardware.", "25,000 API calls a month and 100 a minute on Business"],
  ["Maturity", "Young project (v0.x), community-supported", "Established commercial vendor"],
];
---

<Layout title="OfferKit">
  <div class="relative overflow-hidden">
    <SiteHeader active="home" />

    <main>
      <!-- Hero -->
      <section class="site-container hero">
        <div class="hero-copy">
          <p class="eyebrow">Open-source Voucherify alternative</p>
          <h1>Launch checkout promotions without another deploy.</h1>
          <p class="hero-lede">
            OfferKit is an open-source promotion engine for teams that own their checkout. Integrate
            one API for coupons, gift cards, loyalty, and referrals. After that, your team changes
            offers from the dashboard.
          </p>

          <div class="hero-actions">
            <a href="/docs/getting-started/" class="site-button-primary">
              Read the quickstart <ArrowRightIcon size={16} weight="bold" aria-hidden="true" />
            </a>
            <a
              href={githubUrl}
              target="_blank"
              rel="noreferrer"
              class="site-button-secondary"
            >
              <GithubLogoIcon size={18} weight="bold" aria-hidden="true" />
              <span class="ml-2">View source on GitHub</span>
            </a>
          </div>

          <div class="quickstart">
            <div class="quickstart-head">
              <span>Run it locally · requires Docker</span>
              <button type="button" class="copy-button" data-copy={quickstart} aria-label="Copy quickstart commands">
                <span class="copy-idle"><CopyIcon size={14} weight="bold" aria-hidden="true" /> Copy</span>
                <span class="copy-done"><CheckIcon size={14} weight="bold" aria-hidden="true" /> Copied</span>
              </button>
            </div>
            <pre><code set:html={highlight(quickstart, "bash")} /></pre>
            <p>
              Then open <code>localhost:3000</code>, mint an API key, and create WELCOME10.{" "}
              <a href="/docs/getting-started/">Quickstart steps →</a>
            </p>
          </div>
        </div>

        <div class="hero-proof" data-tabs>
          <div class="code-window">
            <div class="code-window-bar">
              <span class="code-file">checkout.ts</span>
              <div class="segmented" role="tablist" aria-label="Example request">
                {heroExamples.map((example, index) => (
                  <button
                    type="button"
                    role="tab"
                    id={`hero-tab-${example.id}`}
                    aria-controls={`hero-panel-${example.id}`}
                    aria-selected={index === 0 ? "true" : "false"}
                    tabindex={index === 0 ? 0 : -1}
                    data-tab
                  >
                    <span class="tab-long">{example.label}</span>
                    <span class="tab-short" aria-hidden="true">{example.short}</span>
                  </button>
                ))}
              </div>
            </div>
            {heroExamples.map((example, index) => (
              <div
                role="tabpanel"
                id={`hero-panel-${example.id}`}
                aria-labelledby={`hero-tab-${example.id}`}
                hidden={index !== 0}
                data-panel
              >
                <pre class="code-request"><code set:html={highlight(example.request, "ts")} /></pre>
                <div class="code-response">
                  <div class="code-response-label">
                    <span>Response · trimmed</span>
                    <span class:list={["result-badge", example.status === "rejected" ? "result-rejected" : "result-valid"]}>{example.status}</span>
                  </div>
                  <pre><code set:html={highlight(example.json, "json")} /></pre>
                  <p class="code-note">{example.note}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Facts strip -->
      <section class="facts" aria-label="Project facts">
        <dl class="site-container facts-grid">
          {facts.map(({ label, value, href }) => (
            <div>
              <dt>{label}</dt>
              <dd>{href ? <a href={href} target="_blank" rel="noreferrer">{value}</a> : value}</dd>
            </div>
          ))}
        </dl>
      </section>

      <!-- Incentives -->
      <section class="site-container section">
        <div class="section-head split">
          <h2>Four incentive types on one data model.</h2>
          <p>
            Campaigns, customers, orders, and rules are shared by every incentive. Each result below
            came from a real call against a local instance.
          </p>
        </div>

        <div class="incentive-grid">
          {incentives.map(({ title, description, call, result, Icon }) => (
            <article class="incentive">
              <h3><Icon size={20} weight="duotone" aria-hidden="true" />{title}</h3>
              <p>{description}</p>
              <div class="incentive-proof">
                <code>{call}</code>
                <span>{result}</span>
              </div>
            </article>
          ))}
        </div>

        <div class="targeting">
          <div>
            <h3>Target who qualifies</h3>
            <p>
              Attach a JSON Logic rule to a campaign. This one limits <code>VIPWEEKEND</code> to VIP
              customers with a cart of USD 40.00 or more.
            </p>
            <pre><code set:html={highlight(targetingRule, "json")} /></pre>
          </div>
          <ul class="targeting-results" aria-label="Validation results for VIPWEEKEND">
            <li><span>VIP, USD 50.00 cart</span><strong class="is-valid">valid · USD 10.00 off</strong></li>
            <li><span>VIP, USD 25.00 cart</span><strong>validation_failed</strong></li>
            <li><span>Not VIP, USD 50.00 cart</span><strong>validation_failed</strong></li>
          </ul>
        </div>
      </section>

      <!-- Dashboard -->
      <section class="site-container section">
        <div class="section-head split">
          <h2>See exactly why codes fail.</h2>
          <p>
            The admin dashboard ships in the same image. Support sees every failed redemption
            grouped by its typed reason, and marketing adjusts the offer in the same place.
            Screens are from a local instance with demo data.
          </p>
        </div>
        <div class="dashboard-pair">
          <figure>
            <figcaption>Insights: validation failure breakdown</figcaption>
            <img
              class="dashboard-shot"
              src="/images/dashboard-failures.webp"
              width="860"
              height="660"
              loading="lazy"
              decoding="async"
              alt="OfferKit Insights validation failure breakdown: currency_mismatch 21, campaign_inactive 13, redemption_limit_reached 12, customer_required 8, no_discount_effect 5, per_user_redemption_limit_reached 1."
            />
          </figure>
          <figure>
            <figcaption>WELCOME10 discount settings</figcaption>
            <img
              class="dashboard-shot"
              src="/images/dashboard-edit-welcome10.webp"
              width="740"
              height="790"
              loading="lazy"
              decoding="async"
              alt="OfferKit dashboard Discount settings for WELCOME10: fixed amount, discount amount 10.00, no maximum cap, priority 0, exclusive (no stacking) off, active on."
            />
          </figure>
        </div>
      </section>

      <!-- Guarantees -->
      <section class="band band-dark">
        <div class="site-container section">
          <div class="section-head split">
            <h2>Safe to call while money is moving.</h2>
            <p>
              Checkouts retry, double-submit, and fail halfway. These are OfferKit's guarantees
              inside each call, and the one thing your application still owns.
            </p>
          </div>
          <div class="guarantee-grid">
            {guarantees.map(({ title, body, token }, index) => (
              <>
                <div class="guarantee">
                  <span class="guarantee-index">{String(index + 1).padStart(2, "0")}</span>
                  <div>
                    <h3>{title}</h3>
                    <p>{body}</p>
                    {token.endsWith("→") ? <a class="guarantee-link" href="/docs/reference/retries-and-recovery/">{token}</a> : <code>{token}</code>}
                  </div>
                </div>
                {index === 1 && (
                  <div class="code-window retry-window">
                    <div class="code-window-bar">
                      <span class="code-file">retry.ts</span>
                    </div>
                    <pre class="code-request"><code set:html={highlight(retryRequest, "ts")} /></pre>
                    <div class="code-response">
                      <div class="code-response-label">
                        <span>Retry response</span>
                        <span class="result-badge result-valid">same redemption</span>
                      </div>
                      <pre><code set:html={highlight(retryResponse, "json")} /></pre>
                    </div>
                  </div>
                )}
              </>
            ))}
          </div>
        </div>
      </section>

      <!-- Interfaces -->
      <section class="site-container section" data-tabs>
        <div class="interfaces-grid">
          <div>
        <div class="section-head">
          <h2>Call it from code, a terminal, or an agent.</h2>
          <p>
            The REST API, SDK, CLI, and MCP server share one typed contract. They accept the same
            inputs and return the same results.
          </p>
        </div>
        <p class="auth-note">
          Install with <code>npm install @offerkit/sdk</code>. Each surface authenticates with a
          server API key from the dashboard.
        </p>
        <a class="text-link" href="/docs/reference/developer-tools/">
          SDK, REST, CLI, and MCP reference <ArrowRightIcon size={14} weight="bold" aria-hidden="true" />
        </a>
          </div>
        <div class="interface-layout">
          <div class="interface-tabs" role="tablist" aria-label="OfferKit interfaces">
            {interfaces.map((item, index) => (
              <button
                type="button"
                role="tab"
                id={`iface-tab-${item.id}`}
                aria-controls={`iface-panel-${item.id}`}
                aria-selected={index === 0 ? "true" : "false"}
                tabindex={index === 0 ? 0 : -1}
                data-tab
              >
                <span class="interface-label">{item.label}</span>
                <span class="interface-short" aria-hidden="true">{item.short}</span>
              </button>
            ))}
          </div>
          <div class="interface-code">
            {interfaces.map((item, index) => (
              <div
                class="interface-body"
                role="tabpanel"
                id={`iface-panel-${item.id}`}
                aria-labelledby={`iface-tab-${item.id}`}
                hidden={index !== 0}
                data-panel
              >
                <p class="interface-panel-caption">{item.caption}</p>
                <pre class={`lang-${item.lang}`}><code set:html={highlight(item.code, item.lang)} /></pre>
              </div>
            ))}
          </div>
        </div>
        </div>
      </section>

      <!-- Comparison -->
      <section class="band">
        <div class="site-container section">
          <div class="section-head" id="compare">
            <h2>OfferKit or Voucherify?</h2>
          </div>

          <table class="compare-table">
            <thead>
              <tr>
                <th scope="col"><span class="sr-only">Aspect</span></th>
                <th scope="col">OfferKit</th>
                <th scope="col">Voucherify</th>
              </tr>
            </thead>
            <tbody>
              {comparison.map(([aspect, ours, theirs]) => (
                <tr>
                  <th scope="row">{aspect}</th>
                  <td data-label="OfferKit">{ours}</td>
                  <td data-label="Voucherify">{theirs}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <div class="compare-verdict">
            <p><strong>Choose Voucherify</strong> for a managed platform with the widest feature set.</p>
            <p><strong>Choose OfferKit</strong> to own the code, the data, and the deployment, if you're comfortable running it.</p>
          </div>
          <p class="compare-note">
            There is no Voucherify importer yet. Campaigns, vouchers, customers, and validation
            rules are the same core concepts, so offers can be recreated through the API; see{" "}
            <a href="/docs/reference/relationships/">how objects connect</a>. Voucherify figures
            are from its <a href={voucherifyPricingUrl} target="_blank" rel="noreferrer">pricing page</a>,
            checked November 2026.
          </p>
        </div>
      </section>

      <!-- Final CTA -->
      <section class="site-container section section-final">
        <div class="final-cta">
          <div>
            <h2>Start with a working offer.</h2>
            <p>
              Once <code>docker compose up</code> is running, add the SDK to your checkout server or
              try a code from the CLI. The quickstart walks through creating WELCOME10.
            </p>
            <div class="final-actions">
              <a href="/docs/getting-started/" class="site-button-primary">Read the quickstart</a>
              <a href={githubUrl} target="_blank" rel="noreferrer" class="site-button-secondary">
                <GithubLogoIcon size={18} weight="bold" aria-hidden="true" />
                <span class="ml-2">View source on GitHub</span>
              </a>
              <a href="/docs/self-host/" class="final-link">Self-hosting guide <ArrowRightIcon size={14} weight="bold" aria-hidden="true" /></a>
            </div>
          </div>
          <div class="final-command">
            <div class="final-command-head">
              <span>Terminal</span>
              <button type="button" class="copy-button" data-copy={finalCommands} aria-label="Copy setup commands">
                <span class="copy-idle"><CopyIcon size={14} weight="bold" aria-hidden="true" /> Copy</span>
                <span class="copy-done"><CheckIcon size={14} weight="bold" aria-hidden="true" /> Copied</span>
              </button>
            </div>
            <pre><code set:html={highlight(finalCommands, "bash")} /></pre>
          </div>
        </div>
      </section>
    </main>

    <SiteFooter />
  </div>
</Layout>

<script>
  function initializeTabs() {
    document.querySelectorAll<HTMLElement>("[data-tabs]").forEach((root) => {
      if (root.dataset.initialized === "true") return;
      root.dataset.initialized = "true";

      const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-tab]"));
      const panels = Array.from(root.querySelectorAll<HTMLElement>("[data-panel]"));

      const select = (nextIndex: number, focus = false) => {
        const activeIndex = (nextIndex + tabs.length) % tabs.length;
        tabs.forEach((tab, index) => {
          const isActive = index === activeIndex;
          tab.setAttribute("aria-selected", String(isActive));
          tab.tabIndex = isActive ? 0 : -1;
        });
        panels.forEach((panel, index) => {
          panel.hidden = index !== activeIndex;
        });
        if (focus) tabs[activeIndex].focus();
      };

      tabs.forEach((tab, index) => {
        tab.addEventListener("click", () => select(index));
        tab.addEventListener("keydown", (event) => {
          if (event.key === "ArrowRight" || event.key === "ArrowDown") select(index + 1, true);
          else if (event.key === "ArrowLeft" || event.key === "ArrowUp") select(index - 1, true);
          else return;
          event.preventDefault();
        });
      });
    });
  }

  function initializeCopyButtons() {
    document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((button) => {
      if (button.dataset.initialized === "true") return;
      button.dataset.initialized = "true";
      button.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(button.dataset.copy ?? "");
          button.dataset.copied = "true";
          window.setTimeout(() => delete button.dataset.copied, 1_600);
        } catch {
          // Clipboard access can be denied; the commands remain selectable.
        }
      });
    });
  }

  function markScrollableCode() {
    document.querySelectorAll<HTMLPreElement>("pre").forEach((pre) => {
      const update = () => {
        pre.toggleAttribute("data-overflow", pre.scrollWidth - pre.clientWidth > 2);
        pre.toggleAttribute("data-scrolled-end", pre.scrollLeft + pre.clientWidth >= pre.scrollWidth - 2);
      };
      if (pre.dataset.scrollWatch !== "true") {
        pre.dataset.scrollWatch = "true";
        pre.addEventListener("scroll", update, { passive: true });
      }
      update();
    });
  }

  function initializeLandingPage() {
    initializeTabs();
    initializeCopyButtons();
    markScrollableCode();
    document
      .querySelectorAll("[data-tab]")
      .forEach((tab) => tab.addEventListener("click", () => requestAnimationFrame(markScrollableCode)));
    window.addEventListener("resize", markScrollableCode, { passive: true });
  }

  initializeLandingPage();
  document.addEventListener("astro:page-load", initializeLandingPage);
</script>

