---
import Layout from "@/components/layout.astro";
import SiteFooter from "@/components/site-footer.astro";
import SiteHeader from "@/components/site-header.astro";
import "@/styles/global.css";

const surfaces = [
  ["REST API", "OpenAPI 3.1 contract"],
  ["TypeScript SDK", "Typed without codegen"],
  ["CLI", "Back-office operations"],
  ["MCP server", "Risk-aware agent tools"],
];

const capabilities = [
  {
    index: "01",
    title: "Discounts",
    detail: "Codes and automatic offers",
    description: "Fixed or percentage incentives with targeting, limits, priority, exclusivity, and atomic redemption.",
    href: "/docs/solutions/public-promo-code",
  },
  {
    index: "02",
    title: "Gift cards",
    detail: "Balances that reconcile",
    description: "Stored value with partial spend, expiration, rollback safety, and an immutable transaction ledger.",
    href: "/docs/solutions/gift-cards",
  },
  {
    index: "03",
    title: "Loyalty",
    detail: "Every point explained",
    description: "Programs, tiers, earning rules, member balances, reward redemption, and points expiration.",
    href: "/docs/solutions/loyalty",
  },
  {
    index: "04",
    title: "Referrals",
    detail: "Issue, attribute, reward",
    description: "Stable referral codes, idempotent conversion, and configurable rewards for both participants.",
    href: "/docs/solutions/referrals",
  },
];

const steps = [
  ["Validate", "Preview the outcome without moving counters or balances."],
  ["Redeem", "Commit once against a stable order identifier."],
  ["Explain", "Return typed reasons when a rule rejects a request."],
  ["Observe", "Trace the result through audits, events, and webhooks."],
];

const validationExample = `const decision = await offerkit.vouchers.validate({
  params: { code: "WELCOME10" },
  body: {
    order: { amount: 9999, currency: "USD", items: [] },
  },
});`;
---

<Layout title="OfferKit">
  <div class="landing-page">
    <SiteHeader active="home" />

    <main>
      <section class="hero site-container">
        <div class="hero-copy">
          <p class="eyebrow">Open-source promotion infrastructure</p>
          <h1>
            Promotions are infrastructure.
            <span>Treat them like it.</span>
          </h1>
          <p class="hero-summary">
            Run vouchers, gift cards, loyalty, and referrals behind one typed API.
            Keep the data on your infrastructure and every decision explainable.
          </p>
          <div class="hero-actions">
            <a href="/docs/getting-started" class="site-button-primary">
              Run OfferKit <span aria-hidden="true">→</span>
            </a>
            <a href="https://github.com/offerkit/offerkit" class="site-button-secondary">
              View on GitHub
            </a>
          </div>
          <ul class="hero-facts" aria-label="Project attributes">
            <li><strong>MIT</strong><span>licensed</span></li>
            <li><strong>Self-hosted</strong><span>by default</span></li>
            <li><strong>One image</strong><span>to deploy</span></li>
          </ul>
        </div>

        <figure class="product-visual">
          <img
            src="/offerkit-banner.png"
            alt="OfferKit promotion dashboard connected to application infrastructure"
            width="2172"
            height="724"
            fetchpriority="high"
          />
          <figcaption>
            <span>Promotion operations, in one place</span>
            <span>Dashboard · API · Worker</span>
          </figcaption>
        </figure>
      </section>

      <section class="surface-strip" aria-labelledby="surface-title">
        <div class="site-container">
          <h2 id="surface-title" class="sr-only">Developer surfaces</h2>
          <ul>
            {surfaces.map(([title, description]) => (
              <li>
                <strong>{title}</strong>
                <span>{description}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section class="capabilities site-container">
        <header class="section-heading">
          <p class="eyebrow">The promotion layer</p>
          <div>
            <h2>One operational model.<br />Four incentive types.</h2>
            <p>
              Replace scattered checkout rules and one-off admin tools with a system
              your team can inspect, test, and operate.
            </p>
          </div>
        </header>

        <div class="capability-grid">
          {capabilities.map((capability) => (
            <a href={capability.href} class="capability-card">
              <div class="capability-meta">
                <span>{capability.index}</span>
                <span>{capability.detail}</span>
              </div>
              <h3>{capability.title}</h3>
              <p>{capability.description}</p>
              <span class="capability-link">Explore the workflow <span aria-hidden="true">→</span></span>
            </a>
          ))}
        </div>
      </section>

      <section class="checkout-section">
        <div class="site-container">
          <div class="checkout-layout">
            <header class="checkout-copy">
              <p class="eyebrow">Predictable by design</p>
              <h2>Preview freely.<br />Commit once.</h2>
              <p>
                Promotion logic sits on a failure-sensitive path. OfferKit makes
                retries, concurrency, and rejection reasons part of the contract.
              </p>
              <a href="/docs/integrate/checkout">
                Follow the checkout integration <span aria-hidden="true">→</span>
              </a>
            </header>

            <figure class="code-sample">
              <figcaption>
                <span>Voucher validation</span>
                <span>checkout.ts</span>
              </figcaption>
              <pre><code>{validationExample}</code></pre>
              <dl>
                <div><dt>valid</dt><dd>true</dd></div>
                <div><dt>discount</dt><dd>USD 10.00</dd></div>
                <div><dt>order total</dt><dd>USD 89.99</dd></div>
              </dl>
            </figure>
          </div>

          <ol class="checkout-steps">
            {steps.map(([title, description], index) => (
              <li>
                <span>0{index + 1}</span>
                <h3>{title}</h3>
                <p>{description}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section class="deploy-section">
        <div class="site-container deploy-layout">
          <div>
            <p class="eyebrow">Deploy on your terms</p>
            <h2>Your promotions.<br />Your infrastructure.</h2>
            <p>
              Start with Docker Compose, then move the same published image to any
              container platform when you are ready.
            </p>
            <div class="deploy-actions">
              <a href="/docs/getting-started" class="deploy-primary">Get started</a>
              <a href="/docs/self-host" class="deploy-secondary">Self-hosting guide</a>
            </div>
          </div>
          <div class="terminal-line" aria-label="Docker Compose command">
            <span>terminal</span>
            <code><b>$</b> docker compose up --build</code>
            <small>API · DASHBOARD · WORKER</small>
          </div>
        </div>
      </section>
    </main>

    <SiteFooter />
  </div>
</Layout>

<style>
  .landing-page {
    overflow: hidden;
  }

  .eyebrow {
    color: var(--site-primary-strong);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    align-items: center;
    gap: clamp(3rem, 6vw, 5.5rem);
    padding-block: clamp(4.5rem, 8vw, 7.5rem);
  }

  .hero h1 {
    max-width: 42rem;
    margin-top: 1.45rem;
    color: var(--site-heading);
    font-size: clamp(3.3rem, 5.5vw, 4.7rem);
    font-weight: 760;
    letter-spacing: -0.062em;
    line-height: 0.99;
  }

  .hero h1 span {
    display: block;
    color: var(--site-primary);
  }

  .hero-summary {
    max-width: 39rem;
    margin-top: 1.65rem;
    color: var(--site-muted);
    font-size: 1.08rem;
    line-height: 1.75;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .hero-facts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    max-width: 34rem;
    margin-top: 2.3rem;
    border-top: 1px solid var(--site-border);
    padding-top: 1.1rem;
  }

  .hero-facts li {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    border-left: 1px solid var(--site-border);
    padding-left: 1rem;
  }

  .hero-facts li:first-child {
    border-left: 0;
    padding-left: 0;
  }

  .hero-facts strong {
    color: var(--site-heading);
    font-size: 0.82rem;
  }

  .hero-facts span {
    color: var(--site-muted-light);
    font-size: 0.76rem;
  }

  .product-visual {
    overflow: hidden;
    border: 1px solid var(--site-border-strong);
    border-radius: 1.1rem;
    background: white;
    box-shadow: 0 1.4rem 3.5rem rgba(64, 83, 108, 0.14);
  }

  .product-visual img {
    display: block;
    width: 100%;
    aspect-ratio: 1.15;
    object-fit: cover;
    object-position: 74% center;
  }

  .product-visual figcaption {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border-top: 1px solid var(--site-border);
    padding: 0.95rem 1.1rem;
    color: var(--site-heading);
    font-size: 0.75rem;
    font-weight: 650;
  }

  .product-visual figcaption span:last-child {
    color: var(--site-muted-light);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.66rem;
    letter-spacing: 0.06em;
  }

  .surface-strip {
    border-block: 1px solid var(--site-border);
    background: rgba(255, 255, 255, 0.72);
  }

  .surface-strip ul {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  .surface-strip li {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    border-left: 1px solid var(--site-border);
    padding: 1.35rem 1.5rem;
  }

  .surface-strip li:first-child {
    border-left: 0;
    padding-left: 0;
  }

  .surface-strip strong {
    color: var(--site-heading);
    font-size: 0.88rem;
  }

  .surface-strip span {
    color: var(--site-muted);
    font-size: 0.8rem;
  }

  .capabilities {
    padding-block: clamp(5rem, 9vw, 8rem);
  }

  .section-heading {
    display: grid;
    grid-template-columns: 0.72fr 1.28fr;
    gap: 3rem;
    align-items: start;
  }

  .section-heading h2,
  .checkout-copy h2,
  .deploy-section h2 {
    color: var(--site-heading);
    font-size: clamp(2.45rem, 4vw, 3.65rem);
    font-weight: 740;
    letter-spacing: -0.052em;
    line-height: 1.03;
  }

  .section-heading > div > p,
  .checkout-copy > p,
  .deploy-section > .site-container > div > p {
    max-width: 37rem;
    margin-top: 1.25rem;
    color: var(--site-muted);
    font-size: 1.02rem;
    line-height: 1.75;
  }

  .capability-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    overflow: hidden;
    margin-top: 3.5rem;
    border: 1px solid var(--site-border);
    border-radius: 1rem;
    background: var(--site-border);
  }

  .capability-card {
    min-height: 17rem;
    background: white;
    padding: clamp(1.6rem, 3vw, 2.3rem);
    transition: background 160ms ease;
  }

  .capability-card:hover {
    background: #f6fbf9;
  }

  .capability-meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--site-muted-light);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.67rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .capability-card h3 {
    margin-top: 2.4rem;
    color: var(--site-heading);
    font-size: 1.65rem;
    font-weight: 700;
    letter-spacing: -0.035em;
  }

  .capability-card > p {
    max-width: 29rem;
    margin-top: 0.75rem;
    color: var(--site-muted);
    line-height: 1.7;
  }

  .capability-link {
    display: inline-flex;
    gap: 0.5rem;
    margin-top: 2rem;
    color: var(--site-primary-strong);
    font-size: 0.82rem;
    font-weight: 650;
  }

  .checkout-section {
    border-block: 1px solid #d8e8e2;
    background: #eff8f5;
    padding-block: clamp(5rem, 9vw, 8rem);
  }

  .checkout-layout {
    display: grid;
    grid-template-columns: 0.78fr 1.22fr;
    align-items: center;
    gap: clamp(3rem, 8vw, 7rem);
  }

  .checkout-copy h2 {
    margin-top: 1.35rem;
  }

  .checkout-copy a {
    display: inline-flex;
    gap: 0.55rem;
    margin-top: 1.65rem;
    color: var(--site-primary-strong);
    font-size: 0.86rem;
    font-weight: 700;
  }

  .code-sample {
    overflow: hidden;
    border: 1px solid #1f2b3b;
    border-radius: 0.9rem;
    background: #111a27;
    box-shadow: 0 1rem 2.5rem rgba(43, 60, 79, 0.16);
    color: #d8e4ef;
  }

  .code-sample figcaption {
    display: flex;
    justify-content: space-between;
    border-bottom: 1px solid rgba(255, 255, 255, 0.09);
    padding: 0.85rem 1.1rem;
    color: #92a6b9;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .code-sample pre {
    overflow-x: auto;
    padding: 1.5rem 1.35rem;
    color: #c5d4e3;
    font-size: 0.75rem;
    line-height: 1.8;
  }

  .code-sample dl {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid rgba(255, 255, 255, 0.09);
  }

  .code-sample dl div {
    border-left: 1px solid rgba(255, 255, 255, 0.09);
    padding: 0.95rem 1.1rem;
  }

  .code-sample dl div:first-child {
    border-left: 0;
  }

  .code-sample dt {
    color: #70869b;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .code-sample dd {
    margin-top: 0.28rem;
    color: #8ee8c0;
    font-size: 0.8rem;
    font-weight: 700;
  }

  .checkout-steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin-top: 4rem;
    border-top: 1px solid #cddfd8;
  }

  .checkout-steps li {
    border-left: 1px solid #cddfd8;
    padding: 1.5rem 1.4rem 0;
  }

  .checkout-steps li:first-child {
    border-left: 0;
    padding-left: 0;
  }

  .checkout-steps > li > span {
    color: var(--site-muted-light);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.68rem;
  }

  .checkout-steps h3 {
    margin-top: 1rem;
    color: var(--site-heading);
    font-weight: 700;
  }

  .checkout-steps p {
    margin-top: 0.45rem;
    color: var(--site-muted);
    font-size: 0.88rem;
    line-height: 1.65;
  }

  .deploy-section {
    background: #111827;
    color: white;
  }

  .deploy-layout {
    display: grid;
    grid-template-columns: 1fr 0.9fr;
    align-items: center;
    gap: clamp(3rem, 8vw, 8rem);
    padding-block: clamp(4.5rem, 8vw, 7rem);
  }

  .deploy-section .eyebrow {
    color: #75dab6;
  }

  .deploy-section h2 {
    margin-top: 1.3rem;
    color: white;
  }

  .deploy-section > .site-container > div > p {
    color: #aab7c6;
  }

  .deploy-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .deploy-primary,
  .deploy-secondary {
    display: inline-flex;
    align-items: center;
    min-height: 2.8rem;
    border-radius: 0.7rem;
    padding: 0.72rem 1.15rem;
    font-size: 0.86rem;
    font-weight: 700;
  }

  .deploy-primary {
    background: #70deb5;
    color: #0b2b20;
  }

  .deploy-secondary {
    border: 1px solid #405063;
    color: #dce5ed;
  }

  .terminal-line {
    overflow: hidden;
    border: 1px solid #344256;
    border-radius: 0.85rem;
    background: #0b111b;
  }

  .terminal-line > span {
    display: block;
    border-bottom: 1px solid #283547;
    padding: 0.75rem 1rem;
    color: #718198;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.65rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .terminal-line code {
    display: block;
    overflow-x: auto;
    padding: 1.5rem 1.25rem 0.85rem;
    color: #f2f6f9;
    font-size: clamp(0.82rem, 1.5vw, 1rem);
  }

  .terminal-line code b {
    color: #70deb5;
  }

  .terminal-line small {
    display: block;
    padding: 0 1.25rem 1.4rem;
    color: #718198;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.62rem;
    letter-spacing: 0.08em;
  }

  @media (max-width: 63.99rem) {
    .hero,
    .checkout-layout,
    .deploy-layout {
      grid-template-columns: 1fr;
    }

    .hero {
      gap: 3.25rem;
    }

    .product-visual img {
      aspect-ratio: 1.75;
      object-position: 61% center;
    }

    .checkout-copy {
      max-width: 42rem;
    }
  }

  @media (max-width: 47.99rem) {
    .hero {
      padding-block: 4rem 4.5rem;
    }

    .hero h1 {
      font-size: clamp(3rem, 13.5vw, 3.9rem);
    }

    .hero-summary {
      font-size: 1rem;
    }

    .surface-strip ul,
    .capability-grid,
    .checkout-steps {
      grid-template-columns: 1fr 1fr;
    }

    .surface-strip li:nth-child(3) {
      border-left: 0;
    }

    .surface-strip li:nth-child(n + 3) {
      border-top: 1px solid var(--site-border);
    }

    .section-heading {
      grid-template-columns: 1fr;
      gap: 1.4rem;
    }

    .capability-card {
      min-height: 15rem;
    }

    .checkout-steps li:nth-child(3) {
      border-left: 0;
    }

    .checkout-steps li:nth-child(n + 3) {
      margin-top: 1.5rem;
      border-top: 1px solid #cddfd8;
      padding-top: 1.5rem;
    }
  }

  @media (max-width: 35rem) {
    .capability-grid {
      grid-template-columns: 1fr;
    }

    .capability-card {
      padding: 1.4rem;
    }

    .capability-card h3 {
      margin-top: 1.6rem;
    }

    .capability-link {
      margin-top: 1.3rem;
    }
  }

  @media (max-width: 22rem) {
    .hero-facts {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .hero-facts li,
    .hero-facts li:first-child {
      border-left: 0;
      padding-left: 0;
    }

    .product-visual img {
      aspect-ratio: 1.2;
      object-position: 72% center;
    }

    .product-visual figcaption {
      flex-direction: column;
      gap: 0.35rem;
    }

    .surface-strip ul,
    .capability-grid,
    .checkout-steps {
      grid-template-columns: 1fr;
    }

    .surface-strip li,
    .surface-strip li:first-child,
    .surface-strip li:nth-child(3) {
      border-top: 1px solid var(--site-border);
      border-left: 0;
      padding-inline: 0;
    }

    .surface-strip li:first-child {
      border-top: 0;
    }

    .capability-card {
      min-height: auto;
    }

    .checkout-steps li,
    .checkout-steps li:first-child,
    .checkout-steps li:nth-child(3) {
      margin-top: 0;
      border-top: 1px solid #cddfd8;
      border-left: 0;
      padding: 1.35rem 0;
    }

    .checkout-steps li:first-child {
      border-top: 0;
    }

    .code-sample dl {
      grid-template-columns: 1fr;
    }

    .code-sample dl div,
    .code-sample dl div:first-child {
      border-top: 1px solid rgba(255, 255, 255, 0.09);
      border-left: 0;
    }

    .code-sample dl div:first-child {
      border-top: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .capability-card {
      transition: none;
    }
  }
</style>
