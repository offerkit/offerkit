  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@vitest/coverage-v8": "4.1.5",
    "eslint": "^9.39.4",
    "lefthook": "^2.1.6",
    "turbo": "^2.9.14"
  }
}
